---
import { site } from '../data/site';
import { copy } from '../data/copy';

interface Props { downloadPage?: boolean }
const { downloadPage = false } = Astro.props;
---

<footer class:list={['footer', { 'footer--download': downloadPage }]}>
  <slot />
  <div class="container row">
    <div class="footer-copy">
      <span>{copy['footer-copyright']}</span>
      <p class="notice mono" data-notice>
        <span><a class="u" href={site.upstream}>robinebers/openusage</a>의 포크.</span>
        <span>AI provider 이름과 로고는 각 업체 소유.</span>
      </p>
    </div>
    <div class="social-links">
      <a class="social-link" href={site.githubProfile} aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <a class="social-link" href={site.linkedin} aria-label="LinkedIn">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zM3.743 5.182c.837 0 1.358-.554 1.358-1.248-.015-.709-.521-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.4V9.25c0-2.22-1.184-3.252-2.763-3.252-1.274 0-1.845.7-2.165 1.193V6.169h-2.4c.03.678 0 7.225 0 7.225z" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 32px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-base);
  }
  .footer--download {
    min-block-size: calc(100svh - var(--nav-h));
    display: grid;
    grid-template-rows: minmax(min-content, 1fr) auto;
    padding-block: 0;
    border-top: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .footer--download .row {
    padding-block: clamp(16px, 3svh, 32px);
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .footer-copy {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .notice {
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    text-align: left;
  }
  .notice span { display: block; }
  .u {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .social-links {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }
  .social-link {
    display: flex;
    color: var(--ink);
  }
  @media (max-width: 400px) {
    .row { gap: 8px; }
  }
  @media print {
    .footer--download { min-block-size: auto; }
  }
</style>
